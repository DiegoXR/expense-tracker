# Database data. Real data never belongs in the repo: `.wrangler` above holds
# the local D1 state, these catch exports and SQLite files anywhere else.
# Migrations (drizzle/) and seeds (seed/) are schema and defaults, not data.
/backups
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*
*.export.sql

# Env
# .env holds credentials for Node tooling (drizzle-kit).
.env
.env.*
!.env.example
!.env.test

# .dev.vars holds Worker runtime secrets for local development — the local
# stand-in for `wrangler secret put`. Never commit it.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
